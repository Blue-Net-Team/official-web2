# ===========================================
# BlueNet Docker Development Environment
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际环境填写对应的值
# 3. 确保 .env 文件不提交到 Git（已在 .gitignore 中排除）
# ===========================================

# ===========================================
# 环境标识
# ===========================================
# 用于区分不同环境的 Docker 卷名称
# 可选值：dev（开发环境）、prod（生产环境）
ENV=dev

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# 本地/全量部署：使用 infra 或 full profile 启动内置 PostgreSQL 容器，无需设置 DATABASE_HOST
# 生产分离部署：将 DATABASE_HOST 设置为外部 PostgreSQL 服务器地址，留空时使用容器主机名
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=db_blue_net
DATABASE_USERNAME=postgres
DB_PASSWORD=your_database_password

# ===========================================
# Redis Cache Configuration
# ===========================================
# 本地/全量部署：使用 infra 或 full profile 启动内置 Redis 容器，无需设置 REDIS_HOST
# 生产分离部署：将 REDIS_HOST 设置为外部 Redis 服务器地址，留空时使用容器主机名
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# Mail Service Configuration (SMTP)
# ===========================================
# 默认使用 163 邮箱，需开启 SMTP 并填写授权码
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_smtp_password

# ===========================================
# MinIO Object Storage Configuration
# ===========================================
# Docker 容器内部使用主机名 oss，API 端口 9000，宿主机通过 7000 端口访问
# 判题服务分离部署时需将 MINIO_ENDPOINT 设置为主应用服务器地址
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USER=admin
MINIO_PASSWORD=your_minio_secret_key
MINIO_USE_SSL=false
# MinIO 公共访问地址：前端/浏览器直接访问的地址
# Docker 开发环境：填写宿主机局域网 IP + 映射端口，如 http://192.168.1.100:7000
# 生产环境：填写域名或公网 IP，如 https://oss.your-domain.com
MINIO_PUBLIC_URL=http://your-lan-ip:7000

# ===========================================
# Object Storage General
# ===========================================
STORAGE_PROVIDER=minio
STORAGE_BUCKET=bluenet

# ===========================================
# Aliyun OSS Configuration (Optional)
# ===========================================
# 当 STORAGE_PROVIDER=aliyun-oss 时必填
ALIYUN_OSS_ENDPOINT=oss-cn-your-region.aliyuncs.com
ALIYUN_OSS_AK=your_aliyun_oss_access_key_id
ALIYUN_OSS_SK=your_aliyun_oss_access_key_secret
# 公共 Endpoint：用于生成预签名 URL（外网可访问），如 oss-cn-your-region.aliyuncs.com
# 如果与 endpoint 相同可不填
ALIYUN_OSS_PUBLIC_ENDPOINT=

# ===========================================
# RabbitMQ Configuration
# ===========================================
# Docker 容器内部使用主机名 rabbitmq，宿主机通过 5672/15672 端口访问
# 判题服务分离部署时需将 RABBITMQ_HOST 设置为主应用服务器地址
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password

# ===========================================
# JWT Configuration
# ===========================================
# 至少 32 字符，生产环境必须使用强密钥
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# ===========================================
# System User Configuration
# ===========================================
SYSTEM_USER_USERNAME=system
SYSTEM_USER_PASSWORD=your_system_user_password
SYSTEM_USER_STUDENT_ID=000000000000

# ===========================================
# Cookie Configuration
# ===========================================
# 开发环境：COOKIE_DOMAIN=, COOKIE_SECURE=false
# 生产环境：COOKIE_DOMAIN=.yourdomain.com, COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_MAX_AGE=43200

# ===========================================
# CORS Configuration
# ===========================================
# 开发环境：CORS_ALLOWED_ORIGINS=*
# 生产环境：CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# 容器重启策略
# 可选值：no（不重启）、always（总是重启）、unless-stopped（除非手动停止）
RESTART_POLICY=unless-stopped

# ===========================================
# GitHub OAuth Configuration (Optional)
# ===========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_FRONTEND_BASE_URL=http://localhost:3000

# ===========================================
# GitHub App Configuration (Bug Report Sync)
# ===========================================
# 不配置或留空时，同步功能自动禁用，不影响正常提交 Bug 报告
GITHUB_APP_ID=
# 宿主机上私钥文件的路径（PKCS#8 格式），用于挂载到容器内
GITHUB_APP_PRIVATE_KEY_PATH=docker/null.pem
GITHUB_APP_OWNER=your-org
GITHUB_APP_REPO=your-repo
GITHUB_APP_APP_BASE_URL=http://localhost:8080

# ===========================================
# Judge Service
# ===========================================
JUDGE_STORAGE_BUCKET=bluenet-judge

# ===========================================
# AI Service (TBD-RAG)
# ===========================================

# API 密钥
TBD_RAG_SILICONFLOW_API_KEY=
TBD_RAG_DEEPSEEK_API_KEY=

# Milvus 连接
TBD_RAG_MILVUS_URI=http://milvus:19530
TBD_RAG_MILVUS_TOKEN=

# PgVector 连接（当 VECTOR_STORE_BACKEND=pgsql 时使用）
TBD_RAG_PGVECTOR_URI=postgresql://postgres:postgres@database:5432/rag
TBD_RAG_PGVECTOR_POOL_SIZE=10

# Collection 名称
TBD_RAG_TAGS_COLLECTION_NAME=tags_collection
TBD_RAG_CHUNKS_COLLECTION_NAME=chunks_collection
TBD_RAG_DOCS_COLLECTION_NAME=docs_collection

# 向量配置
TBD_RAG_VECTOR_DIMENSION=1024
TBD_RAG_VECTOR_INDEX_TYPE=HNSW
TBD_RAG_VECTOR_METRIC_TYPE=COSINE

# 向量存储后端：milvus | pgsql
TBD_RAG_VECTOR_STORE_BACKEND=milvus

# 语义分片
TBD_RAG_CHUNK_MAX_TOKENS=4000

# Embedding 提供商：siliconflow | ollama
TBD_RAG_EMBEDDING_PROVIDER=siliconflow

# LLM 提供商：siliconflow | deepseek | ollama
TBD_RAG_LLM_PROVIDER=siliconflow
TBD_RAG_LLM_TEMPERATURE=0.7
TBD_RAG_LLM_TIMEOUT=60

# Reranker 提供商：siliconflow | ollama
TBD_RAG_RERANKER_PROVIDER=siliconflow

# Ollama 本地地址（可选）
# TBD_RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
