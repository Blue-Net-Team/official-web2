# ===========================================
# BlueNet 环境变量示例文件
# ===========================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际环境填写对应的值
# 3. 确保 .env 文件权限为 600：chmod 600 .env
# ===========================================

# ===========================================
# 环境标识
# ===========================================
# 用于区分不同环境的 Docker 卷名称
# 可选值：dev（开发环境）、prod（生产环境）
# 默认值：dev
ENV=dev

# ===========================================
# 外部 PostgreSQL 数据库配置
# （PostgreSQL 部署在独立服务器上，不在本 compose 管理范围内）
# ===========================================
DATABASE_HOST=your_postgresql_host_here
DATABASE_PORT=5432
DATABASE_NAME=db_blue_net
DATABASE_USERNAME=postgres

# 数据库密码
DB_PASSWORD=your_database_password_here

# ===========================================
# 外部 Redis 配置
# （Redis 部署在独立服务器上，不在本 compose 管理范围内）
# ===========================================
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ===========================================
# 后端配置
# ===========================================

# RabbitMQ 配置（与后端同服务器部署）
# RABBITMQ_HOST 用于判题服务连接主服务器上的 RabbitMQ
RABBITMQ_HOST=your_main_server_host_here
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password_here

# 邮件配置
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password_here

# MinIO 对象存储配置（与后端同服务器部署）
# MINIO_ENDPOINT 和 MINIO_PORT 用于判题服务连接主服务器上的 MinIO
MINIO_ENDPOINT=your_main_server_host_here
MINIO_PORT=9000
MINIO_AK=admin
MINIO_USE_SSL=false
MINIO_PASSWORD=your_minio_password_here

# JWT 配置（至少 32 字符）
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# 系统用户配置
SYSTEM_USER_USERNAME=system
SYSTEM_USER_PASSWORD=your_system_user_password
# 系统用户12位学号（用于登录）
SYSTEM_USER_STUDENT_ID=000000000000

# Cookie 配置
# 开发环境：COOKIE_DOMAIN=, COOKIE_SECURE=false
# 生产环境：COOKIE_DOMAIN=.yourdomain.com, COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_MAX_AGE=43200

# CORS 配置
# 开发环境：CORS_ALLOWED_ORIGINS=*
# 生产环境：CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# 容器重启策略
# 可选值：no（不重启）、always（总是重启）、unless-stopped（除非手动停止）
RESTART_POLICY=unless-stopped

# ===========================================
# 前端配置
# ===========================================

# 服务端配置（Docker 内部网络）
# SSL 配置
# 开发环境：SSL_ENABLED=false
# 生产环境：SSL_ENABLED=true
SSL_ENABLED=false

# API 前缀（通常不需要修改）
API_PREFIX=/api/v1

# 注意：NEXT_PUBLIC_* 环境变量在构建时打包进 JavaScript 代码
# 运行时设置无效，必须在 CI/CD 构建时通过 build-args 传入
# 参见：docs/自动部署配置指南.md
