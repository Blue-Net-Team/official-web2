# ===========================================
# BlueNet Backend Environment Variables
# ===========================================
# 使用场景：本地直接启动后端（非 Docker）
# 复制此文件为 .env 并填写你的配置值：cp .env.example .env
# ===========================================

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=db_blue_net
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_database_password

# ===========================================
# Mail Service Configuration (SMTP)
# ===========================================
# 默认使用 163 邮箱，需开启 SMTP 并填写授权码
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_smtp_password

# ===========================================
# Object Storage Configuration
# ===========================================
# provider 可选：minio / aliyun-oss
STORAGE_PROVIDER=minio
STORAGE_BUCKET=bluenet

# MinIO 配置（本地开发时 endpoint 为 localhost，port 通常为 7000 或 9000）
MINIO_ENDPOINT=localhost
MINIO_PORT=7000
MINIO_AK=admin
MINIO_SK=your_minio_secret_key
MINIO_USE_SSL=false
# MinIO 公共访问地址：用于生成预签名 URL，浏览器可直接访问
# 本地开发：http://localhost:7000 或宿主机局域网 IP
MINIO_PUBLIC_URL=http://localhost:7000

# 阿里云 OSS 配置（当 STORAGE_PROVIDER=aliyun-oss 时必填）
ALIYUN_OSS_ENDPOINT=oss-cn-your-region.aliyuncs.com
ALIYUN_OSS_AK=your_aliyun_oss_access_key_id
ALIYUN_OSS_SK=your_aliyun_oss_access_key_secret
# 公共 Endpoint：用于生成预签名 URL（外网可访问）
# 如果与 endpoint 相同可不填
ALIYUN_OSS_PUBLIC_ENDPOINT=

# ===========================================
# Redis Cache Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# RabbitMQ Configuration
# ===========================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=your_rabbitmq_password

# ===========================================
# JWT Configuration
# ===========================================
# 至少 32 字符，生产环境必须使用强密钥
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# ===========================================
# System User Configuration
# ===========================================
SYSTEM_USER_USERNAME=system
SYSTEM_USER_PASSWORD=your_system_user_password
SYSTEM_USER_STUDENT_ID=000000000000

# ===========================================
# Cookie Configuration
# ===========================================
# 开发环境：COOKIE_DOMAIN=, COOKIE_SECURE=false
# 生产环境：COOKIE_DOMAIN=.yourdomain.com, COOKIE_SECURE=true
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_MAX_AGE=43200

# ===========================================
# GitHub OAuth Configuration (Optional)
# ===========================================
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_FRONTEND_BASE_URL=http://localhost:3000

# ===========================================
# GitHub App: Issue Sync (Bug Report Sync)
# ===========================================
# 不配置或留空时，同步功能自动禁用
# 注意：旧变量 GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY_PATH 已迁移为以下名称
GITHUB_ISSUE_APP_ID=
GITHUB_ISSUE_PRIVATE_KEY_PATH=path/to/your/private-key-pkcs8.pem
GITHUB_APP_OWNER=your_org_or_user
GITHUB_APP_REPO=your_repo
GITHUB_APP_APP_BASE_URL=http://localhost:8080

# ===========================================
# GitHub App: Org Invitation (组织成员邀请)
# ===========================================
# 需在 GitHub 创建独立 App（Organization members: Read and write），
# 并安装到 Blue-Net-Team 组织。不配置或留空时，邀请功能自动禁用
GITHUB_ORG_APP_ID=
GITHUB_ORG_PRIVATE_KEY_PATH=path/to/your/org-app-private-key-pkcs8.pem

# ===========================================
# CORS Configuration
# ===========================================
# 开发环境：CORS_ALLOWED_ORIGINS=*
# 生产环境：CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# ===========================================
# Judge Service
# ===========================================
JUDGE_STORAGE_BUCKET=bluenet-judge
