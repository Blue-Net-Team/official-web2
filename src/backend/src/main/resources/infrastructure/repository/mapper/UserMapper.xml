<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.UserMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.UserDO">
        <id column="id" property="id"/>
        <result column="student_id" property="studentId"/>
        <result column="email" property="email"/>
        <result column="role_id" property="roleId"/>
        <result column="password" property="password"/>
        <result column="username" property="username"/>
        <result column="nickname" property="nickname"/>
        <result column="college_id" property="collegeId"/>
        <result column="major" property="major"/>
        <result column="assessment_grade_year" property="assessmentGradeYear"/>
        <result column="direction" property="direction"/>
        <result column="gender" property="gender"/>
        <result column="job" property="job"/>
        <result column="avatar_id" property="avatarId"/>
        <result column="disable" property="disable"/>
        <result column="qrcode_id" property="qrcodeId"/>
        <result column="github_id" property="githubId"/>
        <result column="github_username" property="githubUsername"/>
        <result column="internal_referral_code" property="internalReferralCode"/>
    </resultMap>

    <select id="selectByEmail" resultMap="BaseResultMap">
        SELECT *
        FROM tb_user
        WHERE email = #{email}
    </select>

    <select id="selectByStudentId" resultMap="BaseResultMap">
        SELECT *
        FROM tb_user
        WHERE student_id = #{studentId}
    </select>

    <select id="selectByInternalReferralCode" resultMap="BaseResultMap">
        SELECT *
        FROM tb_user
        WHERE internal_referral_code = #{code}
    </select>

    <select id="selectByRoleNamesAndDirection" resultMap="BaseResultMap">
        SELECT u.*
        FROM tb_user u
        INNER JOIN tb_role r ON u.role_id = r.id
        WHERE u.disable = false
        AND u.role_id IS NOT NULL
        <if test="roleNames != null and !roleNames.isEmpty()">
            AND r.name IN
            <foreach collection="roleNames" item="roleName" open="(" separator="," close=")">
                #{roleName}
            </foreach>
        </if>
        <if test="direction != null">
            AND u.direction = #{direction}
        </if>
        <if test="requireDirectionNotNull != null and requireDirectionNotNull">
            AND u.direction IS NOT NULL
        </if>
        <if test="excludeUsername != null and excludeUsername != ''">
            AND u.username != #{excludeUsername}
        </if>
        ORDER BY u.student_id DESC, u.id ASC
    </select>

    <select id="selectByGithubId" resultMap="BaseResultMap">
        SELECT *
        FROM tb_user
        WHERE github_id = #{githubId}
    </select>

    <select id="countByCollegeId" resultType="long">
        SELECT COUNT(*)
        FROM tb_user
        WHERE college_id = #{collegeId}
    </select>

    <select id="selectUserIdsToDisableByElimination" resultType="java.lang.Long">
        SELECT DISTINCT d.user_id
        FROM tb_assessment_decision d
        JOIN tb_user u ON u.id = d.user_id
        WHERE d.passed = false
          AND d.decided_at &lt;= #{cutoffTime}
          AND u.disable = false
    </select>
</mapper>
