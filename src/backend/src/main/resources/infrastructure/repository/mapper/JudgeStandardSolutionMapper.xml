<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.JudgeStandardSolutionMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.JudgeStandardSolutionDO">
        <id column="id" property="id"/>
        <result column="config_id" property="configId"/>
        <result column="question_id" property="questionId"/>
        <result column="language" property="language"/>
        <result column="object_key" property="objectKey"/>
        <result column="object_hash" property="objectHash"/>
        <result column="primary_solution" property="primarySolution"/>
        <result column="benchmark_status" property="benchmarkStatus"/>
        <result column="p95_time_ms" property="p95TimeMs"/>
        <result column="max_time_ms" property="maxTimeMs"/>
        <result column="peak_memory_kb" property="peakMemoryKb"/>
        <result column="suggested_time_limit_ms" property="suggestedTimeLimitMs"/>
        <result column="benchmark_message" property="benchmarkMessage"/>
    </resultMap>

    <delete id="deleteByConfigId">
        DELETE FROM tb_judge_standard_solution
        WHERE config_id = #{configId}
    </delete>

    <select id="selectByConfigId" resultMap="BaseResultMap">
        SELECT * FROM tb_judge_standard_solution
        WHERE config_id = #{configId}
        ORDER BY language
    </select>
</mapper>
