<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.EquipmentMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.EquipmentDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="brand" property="brand"/>
        <result column="description" property="description"/>
        <result column="image_file_id" property="imageFileId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <select id="selectAllOrderBySortOrderDesc" resultMap="BaseResultMap">
        SELECT
            e.id,
            e.name,
            e.brand,
            e.description,
            e.image_file_id,
            e.sort_order
        FROM tb_equipment e
        ORDER BY e.sort_order DESC, e.id ASC
    </select>

    <select id="selectEquipmentById" resultMap="BaseResultMap">
        SELECT
            e.id,
            e.name,
            e.brand,
            e.description,
            e.image_file_id,
            e.sort_order
        FROM tb_equipment e
        WHERE e.id = #{id}
    </select>
</mapper>
