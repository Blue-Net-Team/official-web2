<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.VenueMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.domain.model.entity.Venue">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="subtitle" property="subtitle"/>
        <result column="description" property="description"/>
        <result column="image_file_id" property="imageFileId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <resultMap id="VenueVOResultMap" type="com.bluenet.web.domain.model.vo.VenueVO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="subtitle" property="subtitle"/>
        <result column="description" property="description"/>
        <result column="image_url" property="imageUrl"/>
        <result column="image_file_id" property="imageFileId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <select id="selectAllOrderBySortOrderDesc" resultMap="VenueVOResultMap">
        SELECT
            v.id,
            v.name,
            v.subtitle,
            v.description,
            f.url AS image_url,
            v.image_file_id,
            v.sort_order
        FROM tb_venue v
        LEFT JOIN tb_file f ON v.image_file_id = f.id
        ORDER BY v.sort_order DESC, v.id ASC
    </select>

    <select id="selectByIdWithImageUrl" resultMap="VenueVOResultMap">
        SELECT
            v.id,
            v.name,
            v.subtitle,
            v.description,
            f.url AS image_url,
            v.image_file_id,
            v.sort_order
        FROM tb_venue v
        LEFT JOIN tb_file f ON v.image_file_id = f.id
        WHERE v.id = #{id}
    </select>
</mapper>
