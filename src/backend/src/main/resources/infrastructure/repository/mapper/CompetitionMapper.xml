<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.CompetitionMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.CompetitionDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="short_name" property="shortName"/>
        <result column="logo_file_id" property="logoFileId"/>
        <result column="cover_file_id" property="coverFileId"/>
        <result column="summary" property="summary"/>
        <result column="level" property="level"/>
        <result column="month" property="month"/>
        <result column="organizer" property="organizer"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <select id="selectCompetitionsWithLimit" resultMap="BaseResultMap">
        SELECT
            c.id,
            c.name,
            c.short_name,
            c.logo_file_id,
            c.cover_file_id,
            c.summary,
            c.level,
            c.month,
            c.organizer,
            c.sort_order
        FROM tb_competition c
        ORDER BY c.sort_order ASC, c.id ASC
        LIMIT #{limit}
    </select>

    <select id="selectCompetitionsPage" resultMap="BaseResultMap">
        SELECT
            c.id,
            c.name,
            c.short_name,
            c.logo_file_id,
            c.cover_file_id,
            c.summary,
            c.level,
            c.month,
            c.organizer,
            c.sort_order
        FROM tb_competition c
        ORDER BY c.sort_order ASC, c.id ASC
    </select>

    <select id="selectMaxSortOrder" resultType="java.lang.Integer">
        SELECT MAX(sort_order) FROM tb_competition
    </select>

    <update id="updateSortOrderById">
        UPDATE tb_competition SET sort_order = #{sortOrder} WHERE id = #{id}
    </update>

    <select id="selectAdjacentUp" resultMap="BaseResultMap">
        SELECT * FROM tb_competition
        WHERE sort_order &lt; #{sortOrder}
        ORDER BY sort_order DESC
        LIMIT 1
    </select>

    <select id="selectAdjacentDown" resultMap="BaseResultMap">
        SELECT * FROM tb_competition
        WHERE sort_order &gt; #{sortOrder}
        ORDER BY sort_order ASC
        LIMIT 1
    </select>

    <select id="selectByNames" resultMap="BaseResultMap">
        SELECT *
        FROM tb_competition
        WHERE name IN
        <foreach collection="names" item="name" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>
</mapper>
