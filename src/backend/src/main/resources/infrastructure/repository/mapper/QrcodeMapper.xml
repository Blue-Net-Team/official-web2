<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.QrcodeMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.domain.model.entity.Qrcode">
        <id column="id" property="id"/>
        <result column="file_id" property="fileId"/>
        <result column="type" property="type" typeHandler="org.apache.ibatis.type.EnumOrdinalTypeHandler"/>
    </resultMap>
    <select id="selectByFileId" resultMap="BaseResultMap">
        SELECT * FROM tb_qrcode
        WHERE file_id = #{fileId}
    </select>
</mapper>
