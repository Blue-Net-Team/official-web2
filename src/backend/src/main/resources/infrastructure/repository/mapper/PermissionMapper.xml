<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.PermissionMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.PermissionDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="value" property="value"/>
        <result column="url" property="url"/>
        <result column="method" property="method"/>
        <result column="access_level" property="accessLevel"/>
    </resultMap>
    <select id="selectByRoleId" resultType="java.lang.String">
        SELECT p.value
        FROM tb_permission p
        INNER JOIN tb_role_permission rp ON p.id = rp.permission_id
        WHERE rp.role_id = #{roleId}
    </select>
    <select id="selectPageByConditions" resultMap="BaseResultMap">
        SELECT *
        FROM tb_permission
        <where>
            <if test="keyword != null and keyword.trim() != ''">
                AND (
                    value LIKE CONCAT('%', TRIM(#{keyword}), '%')
                    OR name LIKE CONCAT('%', TRIM(#{keyword}), '%')
                )
            </if>
            <if test="format != null and format.trim() != ''">
                <choose>
                    <when test="format.trim() == 'resource:action'">
                        AND LENGTH(value) - LENGTH(REPLACE(value, ':', '')) = 1
                    </when>
                    <when test="format.trim() == 'resource:subresource:action'">
                        AND LENGTH(value) - LENGTH(REPLACE(value, ':', '')) = 2
                    </when>
                    <when test="format.trim() == 'resource-action:action'">
                        AND value LIKE '%-%'
                    </when>
                </choose>
            </if>
        </where>
        ORDER BY id ASC
    </select>
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT *
        FROM tb_permission
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
