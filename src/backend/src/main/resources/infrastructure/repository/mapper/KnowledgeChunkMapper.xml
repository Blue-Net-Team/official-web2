<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.KnowledgeChunkMapper">

    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.KnowledgeChunkDO">
        <id column="id" property="id"/>
        <result column="doc_id" property="docId"/>
        <result column="content" property="content"/>
        <result column="tags" property="tags" typeHandler="com.bluenet.web.infrastructure.repository.handler.PgTextArrayTypeHandler"/>
        <result column="source" property="source"/>
    </resultMap>

    <delete id="deleteByDocId">
        DELETE FROM tb_rag_chunks WHERE doc_id = #{docId}
    </delete>

    <select id="selectByDocId" resultMap="BaseResultMap">
        SELECT id, doc_id, content, tags, source
        FROM tb_rag_chunks
        WHERE doc_id = #{docId}
        ORDER BY id
    </select>

    <select id="selectPageByDocId" resultMap="BaseResultMap">
        SELECT id, doc_id, content, tags, source
        FROM tb_rag_chunks
        WHERE doc_id = #{docId}
        ORDER BY id
    </select>

</mapper>