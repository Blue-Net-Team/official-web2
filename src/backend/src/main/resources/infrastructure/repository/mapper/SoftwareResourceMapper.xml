<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.SoftwareResourceMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.SoftwareResourceDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="direction" property="direction"
                typeHandler="com.bluenet.web.infrastructure.repository.handler.ValueEnumTypeHandler"/>
        <result column="category" property="category"/>
        <result column="description" property="description"/>
        <result column="external_url" property="externalUrl"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"
                typeHandler="com.bluenet.web.infrastructure.repository.handler.ValueEnumTypeHandler"/>
    </resultMap>

    <select id="selectActiveByDirection" resultMap="BaseResultMap">
        SELECT
            id,
            name,
            direction,
            category,
            description,
            external_url,
            sort_order,
            status
        FROM tb_software_resource
        WHERE status = #{activeStatus, typeHandler=com.bluenet.web.infrastructure.repository.handler.ValueEnumTypeHandler}
        <if test="directions != null and directions.size() > 0">
            AND direction IN
            <foreach item="direction" index="index" collection="directions" open="(" separator="," close=")">
                #{direction, typeHandler=com.bluenet.web.infrastructure.repository.handler.ValueEnumTypeHandler}
            </foreach>
        </if>
        <if test="keyword != null and keyword != ''">
            AND (
                LOWER(name) LIKE CONCAT('%', LOWER(#{keyword}), '%')
                OR LOWER(category) LIKE CONCAT('%', LOWER(#{keyword}), '%')
                OR LOWER(description) LIKE CONCAT('%', LOWER(#{keyword}), '%')
            )
        </if>
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectAllForAdmin" resultMap="BaseResultMap">
        SELECT
            id,
            name,
            direction,
            category,
            description,
            external_url,
            sort_order,
            status
        FROM tb_software_resource
        ORDER BY sort_order ASC, id ASC
    </select>

    <select id="selectMaxSortOrder" resultType="java.lang.Integer">
        SELECT MAX(sort_order) FROM tb_software_resource
    </select>

    <update id="batchUpdateSortOrder">
        UPDATE tb_software_resource
        SET sort_order = CASE id
        <foreach collection="items" item="item">
            WHEN #{item.id} THEN #{item.sortOrder}
        </foreach>
        END
        WHERE id IN
        <foreach collection="items" item="item" open="(" separator="," close=")">
            #{item.id}
        </foreach>
    </update>
</mapper>
