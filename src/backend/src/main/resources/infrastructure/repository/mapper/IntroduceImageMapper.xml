<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.IntroduceImageMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.domain.model.entity.IntroduceImage">
        <id column="id" property="id"/>
        <result column="type" property="type"/>
        <result column="description" property="description"/>
        <result column="file_id" property="fileId"/>
        <result column="direction" property="direction"/>
        <result column="competition_id" property="competitionId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <resultMap id="IntroduceImageVOResultMap" type="com.bluenet.web.domain.model.vo.IntroduceImageVO">
        <id column="id" property="id"/>
        <result column="type" property="type"/>
        <result column="description" property="description"/>
        <result column="file_id" property="fileId"/>
        <result column="file_url" property="fileUrl"/>
        <result column="competition_id" property="competitionId"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <select id="selectByType" resultMap="IntroduceImageVOResultMap">
        SELECT
            ii.id,
            ii.type,
            ii.description,
            ii.file_id,
            f.url AS file_url,
            ii.competition_id,
            ii.sort_order
        FROM tb_introduce_image ii
        LEFT JOIN tb_file f ON ii.file_id = f.id
        WHERE ii.type = #{type}
        ORDER BY ii.sort_order ASC, ii.id ASC
    </select>

    <select id="selectByTypeAndCompetitionId" resultMap="IntroduceImageVOResultMap">
        SELECT
            ii.id,
            ii.type,
            ii.description,
            ii.file_id,
            f.url AS file_url,
            ii.competition_id,
            ii.sort_order
        FROM tb_introduce_image ii
        LEFT JOIN tb_file f ON ii.file_id = f.id
        WHERE ii.type = #{type}
        AND ii.competition_id = #{competitionId}
        ORDER BY ii.sort_order ASC, ii.id ASC
    </select>

    <select id="countByTypeAndCompetitionId" resultType="int">
        SELECT COUNT(*)
        FROM tb_introduce_image
        WHERE type = #{type}
        AND competition_id = #{competitionId}
    </select>
</mapper>
