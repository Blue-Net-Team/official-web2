<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bluenet.web.infrastructure.repository.mapper.CollegeMapper">
    <resultMap id="BaseResultMap" type="com.bluenet.web.infrastructure.repository.dataobject.CollegeDO">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
    </resultMap>

    <select id="countByName" resultType="long">
        SELECT COUNT(*)
        FROM tb_college
        WHERE name = #{name}
    </select>

    <select id="countByNameAndIdNot" resultType="long">
        SELECT COUNT(*)
        FROM tb_college
        WHERE name = #{name}
          AND id != #{excludeId}
    </select>
</mapper>
