# Server-side (Docker internal network)
BACKEND_HOST=localhost
BACKEND_PORT=8080
SSL_ENABLED=false
API_PREFIX=/api/v1

# Client-side (external accessible address)
NEXT_PUBLIC_BACKEND_HOST=localhost
NEXT_PUBLIC_BACKEND_PORT=8080
NEXT_PUBLIC_SSL_ENABLED=false
NEXT_PUBLIC_API_PREFIX=/api/v1

# AI Service（独立于主 API 服务）
NEXT_PUBLIC_AI_SERVICE_HOST=localhost
NEXT_PUBLIC_AI_SERVICE_PORT=8000
NEXT_PUBLIC_AI_SERVICE_SSL_ENABLED=false
NEXT_PUBLIC_AI_SERVICE_PREFIX=/ai/v1
