#!/bin/sh
#
# BlueNet 项目 Commit-msg Hook
# 检查提交信息是否符合规范
#

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# 提取第一行作为 subject（标题行）
SUBJECT=$(echo "$COMMIT_MSG" | head -n 1)

# 提交信息规范
# 格式: type: description 或 type(scope): description
# type 可选值: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert
# 支持多行：第一行为 subject，空行后为 body（补充说明）

VALID_TYPES="feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert"

# 允许的提交类型及说明
cat <<EOF

📋 提交信息规范:
  feat     - 新功能
  fix      - 修复 Bug
  docs     - 文档更新
  style    - 代码格式（不影响功能）
  refactor - 重构
  test     - 测试相关
  chore    - 构建/工具变动
  perf     - 性能优化
  ci       - CI/CD 配置变动
  build    - 构建系统变动
  revert   - 回滚提交

📝 格式: type: description 或 type(scope): description
   示例: feat: 添加用户登录功能
   示例: feat(UI): 添加登录表单组件

   多行格式:
   type: subject
   <空行>
   body（补充说明）

EOF

# 检查提交信息格式（只检查第一行 subject）
# 格式: type(scope): description 或 type: description (冒号后必须有空格)
if ! echo "$SUBJECT" | grep -qE "^($VALID_TYPES)(\(.+\))?: .+"; then
  echo "❌ 提交信息格式错误！"
  echo ""
  echo "当前提交信息: $SUBJECT"
  echo ""
  echo "💡 正确格式: type: description 或 type(scope): description"
  echo "   例如: feat: 添加用户登录功能"
  echo "   例如: feat(UI): 添加登录表单组件"
  echo "   例如: fix: 修复登录页面样式问题"
  echo ""
  echo "📌 支持的类型: feat, fix, docs, style, refactor, test, chore, perf, ci, build, revert"
  exit 1
fi

# 检查描述长度（至少 5 个字符）
DESCRIPTION=$(echo "$SUBJECT" | sed -E "s/^($VALID_TYPES)(\(.+\))?: //")
DESC_LENGTH=${#DESCRIPTION}

if [ $DESC_LENGTH -lt 5 ]; then
  echo "⚠️  提交描述太短，请提供更有意义的描述"
  echo "   当前描述: $DESCRIPTION"
  echo "   建议至少 5 个字符"
  exit 1
fi

# 检查描述是否以句号结尾（不推荐）
if echo "$DESCRIPTION" | grep -qE "\。$"; then
  echo "⚠️  提交描述不建议以句号结尾"
  echo "   当前描述: $DESCRIPTION"
  echo "   建议格式: 添加用户登录功能"
  exit 1
fi

echo "✅ 提交信息格式正确"
exit 0
