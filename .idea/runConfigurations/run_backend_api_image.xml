<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="运行 后端api 镜像" type="docker-deploy" factoryName="dockerfile" server-name="Docker">
    <deployment type="dockerfile">
      <settings>
        <option name="imageTag" value="bluenet-api-service:latest" />
        <option name="containerName" value="backend-api-dev" />
        <option name="envVars">
          <list />
        </option>
        <option name="portBindings">
          <list>
            <DockerPortBindingImpl>
              <option name="containerPort" value="8080" />
              <option name="hostPort" value="8080" />
