{
  "uid": "bluenet-local-load-test",
  "title": "BlueNet Local Load Test",
  "description": "System metrics only. Use k6 JSONL/report for business throughput and valid completed workflows.",
  "timezone": "Asia/Shanghai",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bluenet-prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes, namespace)",
        "current": {
          "text": "bluenet",
          "value": "bluenet"
        },
        "refresh": 2
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "bluenet-prometheus"
        },
        "query": "label_values(kube_pod_info{namespace=\"$namespace\"}, pod)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape target health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (up)",
          "legendFormat": "{{pod}} {{uri}} {{job}} {{queue}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pod CPU usage",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-resource\", namespace=\"$namespace\", pod=~\"$pod\", container!=\"\"}[$__rate_interval]))) and on(namespace, pod) kube_pod_info{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}} {{uri}} {{job}} {{queue}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
