    {
      "id": 7,
      "title": "API HTTP P95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
