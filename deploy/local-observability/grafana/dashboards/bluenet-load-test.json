          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le, namespace, pod, uri) (rate(http_server_requests_seconds_bucket{service=\"bluenet-api\", namespace=\"$namespace\"}[$__rate_interval])))) and on(namespace, pod) kube_pod_info{namespace=\"$namespace\"}",
