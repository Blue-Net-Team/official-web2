          "refId": "A",
          "expr": "(sum by (namespace, pod) (rate(http_server_requests_seconds_count{service=\"bluenet-api\", namespace=\"$namespace\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (namespace, pod) (rate(http_server_requests_seconds_count{service=\"bluenet-api\", namespace=\"$namespace\"}[$__rate_interval])), 1e-9)) and on(namespace, pod) kube_pod_info{namespace=\"$namespace\"}",
