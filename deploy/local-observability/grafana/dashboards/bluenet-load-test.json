      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (kube_pod_container_status_restarts_total{namespace=\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} {{uri}} {{job}} {{queue}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Last termination: OOMKilled",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
