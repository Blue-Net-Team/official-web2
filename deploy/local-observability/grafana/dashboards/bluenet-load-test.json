      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod, container) (kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", pod=~\"$pod\", reason=\"OOMKilled\"})",
          "legendFormat": "{{pod}} {{uri}} {{job}} {{queue}} {{state}} {{mode}}"
        }
      ]
    },
    {
