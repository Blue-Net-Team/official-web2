      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (namespace, pod) (container_memory_working_set_bytes{job=\"kubernetes-resource\", namespace=\"$namespace\", pod=~\"$pod\", container!=\"\"})) and on(namespace, pod) kube_pod_info{namespace=\"$namespace\"}",
          "legendFormat": "{{pod}} {{uri}} {{job}} {{queue}} {{state}} {{mode}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Container restarts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "bluenet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
