# Copy to deploy/local-observability/.env and use locally generated secrets only.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-random-password
POSTGRES_MONITOR_PASSWORD=replace-with-a-local-random-password
# The current local Redis has no password; leave empty only for that local setup.
REDIS_PASSWORD=

# Optional host ports; both bind to loopback only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
